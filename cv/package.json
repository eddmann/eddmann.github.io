{
  "name": "cv",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run generate.ts",
    "build:html": "bun run generate.ts --formats html",
    "build:pdf": "bun run generate.ts --formats pdf",
    "build:txt": "bun run generate.ts --formats txt",
    "serve": "bun run generate.ts --serve",
    "format": "bun x prettier --write \"**/*.{ts,json,md}\""
  },
  "dependencies": {
    "puppeteer": "^24.43.1"
  },
  "trustedDependencies": [
    "puppeteer"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
